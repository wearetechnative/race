#(C)2019-2022 Pim Snel - https://github.com/mipmip/RUNME.sh
CMDS=();DESC=();make_command(){ CMDS+=($1);DESC+=("$2");};usage(){ printf "\nUsage: %s [command]\n\nCommands:\n" $(basename $0);line="              ";for((i=0;i<=$(( ${#CMDS[*]} -1));i++));do printf "  %s %s ${DESC[$i]}\n" ${CMDS[$i]} "${line:${#CMDS[$i]}}";done;echo;};runme(){ local c;if test $# -ge 1;then for c in "${CMDS[@]}";do if test "$c" = "$1";then shift;"$c" "$@";return $?;fi;done;fi;usage;return 1;}

# INCLUDE LIB
thisdir="$(dirname "$0")"
eval thisdir=$thisdir
source "$thisdir/_racelib.sh"

##### PLACE YOUR COMMANDS BELOW #####

make_command "usage" "Show this help."

make_command "version" "Show race version"
version(){
  show_version
}

make_command "elastinixkey" "Generate ssh key"
elastinixkey(){
  $thisdir/elastinix_ssh_keypair.sh
}

make_command "plan" "run tfplan in TF Standard Base"
plan(){
  "$thisdir/tfplan.sh" "$@"
}

make_command "apply" "nix run apply target if flake.nix exists, else tfapply (--override-tf: force tfapply)"
apply(){
  race_apply "$@"
}

make_command "destroy" "run tfdestroy in TF Standard Base"
destroy(){
  "$thisdir/tfdestroy.sh" "$@"
}

make_command "terraform_raw" "echo raw terraform command"
terraform_raw(){
  set_tf_vars

  if [[ ! -z ${TF_VAR} ]]; then
    echo "terraform [command] -var-file=${TF_VAR} $@"
  else
    echo "terraform [command] $@"
  fi
}


make_command "init" "run tfbackend in TF Standard Base"
init(){
  $thisdir/tfbackend.sh
}

make_command "nixrun" "run nix run for the selected terraform backend (all targets)"
nixrun(){
  "$thisdir/nixrun.sh" "$@"
}

##### PLACE YOUR COMMANDS ABOVE #####

runme "$@"
